name "dcad"
description "Statically typed CAD scripting in D, bound directly to OpenCASCADE"
authors "dcad contributors"
copyright "Copyright (c) 2026"
license "LGPL-2.1-or-later"

targetType "library"
sourcePaths "source"
importPaths "source"

# OpenCASCADE's C++ runtime and libraries. LDC uses the platform's native C++
# ABI: Itanium on Linux/macOS, Microsoft on Windows. The OCCT packages for each
# target are built with the matching ABI.
libs "TKernel" "TKMath" "TKG2d" "TKG3d" "TKGeomBase" "TKGeomAlgo" \
     "TKBRep" "TKTopAlgo" "TKPrim" "TKBO" "TKBool" "TKFillet" "TKOffset" \
     "TKXSBase" "TKMesh"
# OCCT 7.7 in Debian/Ubuntu splits Data Exchange differently from Homebrew
# and the official 7.9 MSVC packages, which ship aggregate TKDE/TKDESTEP.
libs "TKDE" "TKDESTEP" platform="osx"
libs "TKDE" "TKDESTEP" platform="windows"
libs "TKSTEP" "TKSTEPBase" "TKSTEPAttr" "TKSTEP209" \
     "TKXDESTEP" "TKXDEIGES" platform="linux"
libs "stdc++" platform="linux"
libs "c++" platform="osx"
lflags "-L/opt/homebrew/lib" "-rpath" "/opt/homebrew/lib" platform="osx"
lflags "-L/usr/local/lib" platform="osx"
# CI stages the official OCCT and GLFW binaries here on Windows (see README).
lflags "/LIBPATH:C:\\dcad\\occt\\lib" platform="windows"

# The tiny C++ shim: only for API that extern(C++) cannot express
# (OCCT inline accessors, Handle types, and C++ exception containment).
preBuildCommands "$PACKAGE_DIR/tools/build-shim.sh" platform="posix"
preBuildCommands "python $PACKAGE_DIR/tools/build_shims.py core" platform="windows"
lflags "$PACKAGE_DIR/build/libdcad_shim.a" platform="posix"
lflags "$PACKAGE_DIR/build/dcad_shim.lib" platform="windows"
extraDependencyFiles "shim/dcad_shim.cpp" "shim/dcad_shim.h" \
                     "tools/build-shim.sh" "tools/build_shims.py"

subPackage {
    name "simple-box"
    targetType "executable"
    targetName "simple-box"
    sourcePaths "examples/simple_box"
    importPaths "source"
    dependency "dcad" version="*"
}

subPackage {
    name "box-hole-fillet"
    targetType "executable"
    targetName "box-hole-fillet"
    sourcePaths "examples/box_hole_fillet"
    importPaths "source"
    dependency "dcad" version="*"
}

subPackage {
    name "loft"
    targetType "executable"
    targetName "loft"
    sourcePaths "examples/loft"
    importPaths "source"
    dependency "dcad" version="*"
}

subPackage {
    name "coffee-table"
    targetType "executable"
    targetName "coffee-table"
    sourcePaths "samples/coffee-table"
    importPaths "samples/coffee-table" "source"
    versions "Standalone"
    dependency "dcad" version="*"
}

# Native GUI shell: GLFW + ImGui (docking) + raw OpenGL + hot-loaded D scripts.
subPackage {
    name "gui"
    targetType "executable"
    targetName "dcad-gui"
    sourcePaths "gui/source"
    excludedSourceFiles "gui/source/launcher/main.d" \
                        "gui/source/launcher/embedded.d"
    importPaths "gui/source" "source"
    dependency "dcad" version="*"
    dependency "bindbc-glfw" version="~>1.1"
    subConfiguration "bindbc-glfw" "static"
    dependency "bindbc-opengl" version="~>1.1"
    versions "GL_30" "GLFW_33"

    preBuildCommands "$PACKAGE_DIR/gui/tools/build-gui-shim.sh" platform="posix"
    preBuildCommands "python $PACKAGE_DIR/tools/build_shims.py gui" platform="windows"
    lflags "$PACKAGE_DIR/build/libdcad_gui_shim.a" platform="posix"
    lflags "$PACKAGE_DIR/build/dcad_gui_shim.lib" platform="windows"
    libs "glfw" platform="osx"
    libs "glfw" "GL" "X11" platform="linux"
    libs "glfw3_mt" "opengl32" "user32" "gdi32" platform="windows"
    lflags "-L/opt/homebrew/lib" platform="osx"
    lflags "-framework" "OpenGL" platform="osx"
    lflags "-framework" "Cocoa" platform="osx"
    extraDependencyFiles "gui/shim/dcad_gui_shim.cpp" \
                         "gui/shim/dcad_native_menu.mm" \
                         "gui/shim/dcad_native_menu_win.cpp" \
                         "gui/shim/dcad_native_menu_x11.cpp" \
                         "gui/tools/build-gui-shim.sh" "tools/build_shims.py"
}

# Self-extracting launcher. The released binary is this target: it contains
# the real dcad-gui, assets, SDK and native libraries, and starts the GUI from
# a versioned cache directory with no system install required. Build :gui
# first so its binary can be embedded.
subPackage {
    name "gui-launcher"
    targetType "executable"
    targetName "dcad-launcher"
    sourcePaths "gui/source/launcher"
    importPaths "gui/source/launcher"
    preBuildCommands "python $PACKAGE_DIR/tools/build_shims.py launcher"
    lflags "$PACKAGE_DIR/build/dcad_resources.o" platform="posix"
    lflags "$PACKAGE_DIR/build/dcad_resources.res" platform="windows"
    # No console window on Windows: the launcher uses WinMain and shows fatal
    # errors in a message box instead.
    lflags "/SUBSYSTEM:WINDOWS" platform="windows"
    extraDependencyFiles "gui/source/launcher/embedded.d" \
                         "tools/build_shims.py" "tools/build_resources.py" \
                         "tools/relocate_macos.py" \
                         "project-template/daimochi/.dcad.toml"
}

# Exercises the script host's body-style and module-style forms headlessly.
subPackage {
    name "script-host-smoke"
    targetType "executable"
    targetName "dcad-script-host-smoke"
    sourcePaths "gui/source" "tests/script-host-smoke"
    excludedSourceFiles "gui/source/gui/app.d" "gui/source/gui/viewport.d" \
                        "gui/source/launcher/main.d" \
                        "gui/source/launcher/embedded.d"
    mainSourceFile "tests/script-host-smoke/main.d"
    importPaths "gui/source" "source"
    dependency "dcad" version="*"
    preBuildCommands "$PACKAGE_DIR/gui/tools/build-gui-shim.sh" platform="posix"
    preBuildCommands "python $PACKAGE_DIR/tools/build_shims.py gui" platform="windows"
    lflags "$PACKAGE_DIR/build/libdcad_gui_shim.a" platform="posix"
    lflags "$PACKAGE_DIR/build/dcad_gui_shim.lib" platform="windows"
    # The GUI shim also contains the GLFW/OpenGL backends, so this test binary
    # needs the same native libraries as :gui even though it never opens a
    # window. macOS gets them through the core library's framework links.
    libs "glfw" "GL" "X11" "Xrandr" "Xinerama" "Xcursor" "Xi" platform="linux"
    libs "glfw3_mt" "opengl32" "user32" "gdi32" platform="windows"
    extraDependencyFiles "gui/shim/dcad_gui_shim.cpp" \
                         "gui/tools/build-gui-shim.sh" "tools/build_shims.py"
}
